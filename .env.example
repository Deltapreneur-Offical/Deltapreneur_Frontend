# Local dev (optional) — copy to .env.local
# VITE_API_URL=http://localhost:8080
# VITE_APP_URL=http://localhost:5173
# VITE_API_PROXY_TARGET=http://localhost:8080

# Local FastAPI (Uvicorn is HTTP-only — do not use https://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000
VITE_APP_URL=http://127.0.0.1:5173

# Production (Vercel): set BOTH — do NOT point VITE_API_URL at the Vercel frontend URL
# VITE_API_URL=https://cobrother-backend.onrender.com
# VITE_APP_URL=https://co-brother-frontend.vercel.app
# (If unset, defaults in src/config/urls.js apply; vercel.json proxies /api → Render)
