# Local dev (optional) — copy to .env.local
# VITE_API_URL=http://127.0.0.1:8000
# VITE_APP_URL=http://localhost:5173
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Local FastAPI (Uvicorn is HTTP-only — do not use https://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000
VITE_APP_URL=http://127.0.0.1:5173

# Production (Vercel):
# VITE_APP_URL=https://co-brother-frontend.vercel.app
# Optional — leave unset to proxy /api via vercel.json; OAuth always uses Render backend.
# VITE_API_URL=https://cobrother-backend.onrender.com
# NEVER set VITE_API_URL to your Vercel frontend URL (breaks Google login).
