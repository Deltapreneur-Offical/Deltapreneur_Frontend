# Local dev (optional) — copy to .env.local
# VITE_API_URL=http://localhost:8080
# VITE_APP_URL=http://localhost:5173
# VITE_API_PROXY_TARGET=http://localhost:8080

# Local FastAPI (Uvicorn is HTTP-only — do not use https://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000
VITE_APP_URL=http://127.0.0.1:5173

# Production build: set in hosting dashboard, e.g.
# VITE_API_URL=https://backend.cobrother.com
# VITE_APP_URL=https://cobrother.com
