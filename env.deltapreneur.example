# Deltapreneur frontend — copy to .env (never commit .env)

VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_APP_URL=http://127.0.0.1:5173
# Local: leave VITE_API_URL unset so Vite proxies to VITE_DEV_PROXY_TARGET
# Production later:
# VITE_API_URL=https://api.deltapreneur.com
# VITE_APP_URL=https://deltapreneur.com

VITE_TURNSTILE_SITE_KEY=

