
# Production:
VITE_API_URL=https://api.deltapreneur.com
VITE_APP_URL=https://deltapreneur.com

# Local dev (Vite proxies /api → http://127.0.0.1:8000):
# VITE_API_URL=http://127.0.0.1:8000
# VITE_APP_URL=http://127.0.0.1:5173

# Must match backend REQUIRE_DOMAIN_VERIFICATION_BEFORE_PURCHASE
VITE_REQUIRE_DOMAIN_VERIFICATION_BEFORE_PURCHASE=true
# Must match backend REQUIRE_TECHNOLOGY_VERIFICATION_BEFORE_PURCHASE
VITE_REQUIRE_TECHNOLOGY_VERIFICATION_BEFORE_PURCHASE=true

# Local dummy always-pass key. Production uses the real public site key on Vercel:
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAErAJk9ECeMGvhli
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
